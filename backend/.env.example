# ==============================================================================
# DocuMind AI — Backend Production & Local Environment Configuration
# ==============================================================================

# 1. API Keys (Required)
# Google Gemini API Key for Document Embeddings (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key for Fast Conversational LLM (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# 2. Model Selection
# Groq Chat Model (e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Gemini Embedding Model (e.g. gemini-embedding-001 or models/text-embedding-004)
EMBEDDING_MODEL=gemini-embedding-001

# 3. RAG Splitting & Retrieval Tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_CHUNKS=4

# 4. Gemini Embedding Rate-Limit Throttling & Resilience
EMBEDDING_BATCH_SIZE=10
EMBEDDING_BATCH_DELAY=0.6
EMBEDDING_MAX_RETRIES=3

# 5. Server & Security Settings
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins (Comma-separated origins for production frontend)
# Example: http://localhost:5173,https://multi-pdf-chatbot-docu-mind-ai.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://multi-pdf-chatbot-docu-mind-ai.vercel.app
